.{
    .name = .s2geometry,
    // Upstream's own version record. `CMakeLists.txt` still says
    // `project(s2-geometry VERSION 0.12.0)` inside the v0.14.0 tag; that line
    // is stale and this fork does not change it. The tag is the version.
    .version = "0.14.0",
    .minimum_zig_version = "0.16.0",

    // Identifies this package. It belongs to this manifest only and must not
    // be copied from another package.
    .fingerprint = 0x0e436f7bf16da9d8,

    // Abseil LTS 20250814.1 is vendored at `vendor/abseil-cpp`, the version
    // s2geometry's own CMake fetches. Nothing is fetched at build time, so
    // there is no dependency to declare.
    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        // This fork's `cross-test` profile: the build step and the two build
        // defaults the published 53-platform matrix is run with.  It is
        // discovered from the package root, so a dependent that materialises
        // this package can run the same matrix; it selects no target and
        // names no machine.
        "cross-test.profile.sh",
        "build_support",

        // The facade, the bridge this fork compiles in every mode, and the
        // behavioural roots.
        "zig",
        "tests.zig",
        "smoke.zig",
        "testdata",
        "consumer",

        // Upstream C++ sources and their headers.  These are upstream's bytes,
        // not this fork's: the one modified file under `src` and the seven
        // under `vendor` are bounded portability corrections, each disclosed
        // with its pristine and current digest in UPSTREAM.sha256, and each
        // carrying a prominent change notice.  See UPSTREAM.md,
        // "Owner-authorised upstream portability changes".
        "src",

        // The vendored Abseil tree, source of every Abseil object and of the
        // installed `absl/` headers.
        "vendor",

        // Upstream build definition, formatting configuration and licence
        // records, carried so the tree can still be built and audited the way
        // upstream describes.
        "CMakeLists.txt",
        "Config.cmake.in",
        ".clang-format",
        "AUTHORS",
        "CONTRIBUTORS",
        "CONTRIBUTING.md",
        "LICENSE",
        "NOTICE",
        "README.md",

        // Upstream's own Python packaging.  `pyproject.toml` and `setup.py`
        // are named in `UPSTREAM.sha256` alongside the rest of the pinned
        // tree, so a package that shipped everything except them would carry
        // a different upstream than the one this fork recorded, and the
        // digest check would have nothing to check them against.
        "pyproject.toml",
        "setup.py",

        // This fork's own records. A private repository removes no upstream
        // licence obligation.
        "README.zig.md",
        "UPSTREAM.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "UPSTREAM.sha256",
    },
}
